class Solution:
    def removeUtil(self, s):

        ans = ""
        i = 0

        while i < len(s):

            if i < len(s) - 1 and s[i] == s[i + 1]:

                while i < len(s) - 1 and s[i] == s[i + 1]:
                    i += 1

                i += 1

            else:
                ans += s[i]
                i += 1

        # Base Case
        if ans == s:
            return ans

        # Recursive Call
        return self.removeUtil(ans)
